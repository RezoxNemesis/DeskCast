{
  "name": "deskcast-mirror",
  "productName": "DeskCast Mirror",
  "version": "1.0.0",
  "description": "See and hear your Android phone on your Linux PC over Wi-Fi (pairs with the DeskCast phone app).",
  "main": "src/main.js",
  "homepage": "https://github.com/RezoxNemesis/DeskCast",
  "author": {
    "name": "RezoxNemesis",
    "email": "rezoxnemesis@users.noreply.github.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/protocol.test.js",
    "fake-phone": "node test/fake-phone.js",
    "dist": "electron-builder --linux deb AppImage --publish never"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.rezox.deskcast.mirror",
    "productName": "DeskCast Mirror",
    "artifactName": "DeskCast-Mirror-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Video",
      "icon": "build/icon.png",
      "executableName": "deskcast-mirror",
      "synopsis": "Mirror your Android phone to your PC",
      "desktop": {
        "entry": {
          "Name": "DeskCast Mirror",
          "Comment": "Mirror your Android phone (screen and sound) over Wi-Fi",
          "Keywords": "android;phone;mirror;screen;cast;"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0 | libatspi2.0-0t64",
        "libuuid1",
        "libsecret-1-0"
      ]
    }
  }
}
